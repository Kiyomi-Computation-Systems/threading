#!r6rs ; -*- scheme -*-
(import (akku format manifest))

;; The package installs the libraries under src/, which are plain R6RS and
;; depend on nothing. The suites' SRFI-64 comes from chez-srfi, a submodule
;; under vendor/. chez-cmark-gfm is a development dependency used only to
;; render docs/ for the static site; it is never imported by src/. .akkuignore
;; keeps the tests, the tooling and the plans out of the package.
(akku-package ("threading" "0.1.0")
  (synopsis "Threading macros (~>, ~>>, and~> and friends) for R6RS Scheme")
  (authors "Kiyomi Computation Systems LLC")
  (homepage "https://github.com/Kiyomi-Computation-Systems/threading")
  (license "BSD-3-Clause AND ISC")
  (depends/dev ("chez-cmark-gfm" "^2.0.0")))
