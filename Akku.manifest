#!r6rs ; -*- scheme -*-
(import (akku format manifest))

;; The package installs only (threading) under src/, which is plain R6RS and
;; depends on nothing. chez-cmark-gfm renders the documentation site during
;; development; .akkuignore keeps the site, docs, tests, tooling and plans out
;; of the installed package.
(akku-package ("threading" "0.1.1")
  (synopsis "Threading macros (~>, ~>>, and~> and friends) for R6RS Scheme")
  (authors "Kiyomi Computation Systems LLC")
  (homepage "https://github.com/Kiyomi-Computation-Systems/threading")
  (license "BSD-3-Clause AND ISC")
  (depends/dev ("chez-cmark-gfm" "^2.0.0")))
