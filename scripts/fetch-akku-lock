#!/bin/sh
# Get packages exactly as Akku.lock pins them without requiring the akku tool.
set -eu

lock=${AKKU_LOCK:-Akku.lock}
dest=${AKKU_DEST:-build/akku}

if [ "$#" -lt 1 ]; then
  echo "usage: fetch-akku-lock NAME..." >&2
  exit 2
fi
if [ ! -f "$lock" ]; then
  echo "fetch-akku-lock: $lock not found" >&2
  exit 1
fi

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

# Print URL and SHA256 for a lock entry.  Akku writes the package name before
# its URL and digest, so this small parser does not need an Akku runtime.
lookup() {
  awk -v want="$1" '
    /\(name "/ { split($0, a, "\""); name = a[2]; url = ""; next }
    name == want && /\(url "/ { split($0, a, "\""); url = a[2]; next }
    name == want && url != "" && /"[0-9a-f]+"/ {
      split($0, a, "\""); print url, a[2]; exit
    }' "$lock"
}

fetch() {
  if command -v curl >/dev/null 2>&1; then
    curl -sSfL -o "$2" "$1"
  else
    wget -q -O "$2" "$1"
  fi
}

mkdir -p "$dest/dl"
status=0
for name in "$@"; do
  set -- $(lookup "$name")
  if [ "$#" -ne 2 ]; then
    echo "fetch-akku-lock: $name is not in $lock" >&2
    status=1
    continue
  fi
  url=$1 want=$2 tree=$dest/$name
  if [ -d "$tree" ] && [ "$(cat "$tree.sha256" 2>/dev/null)" = "$want" ]; then
    echo "fetch-akku-lock: $name is up to date ($tree)"
    continue
  fi
  archive=$dest/dl/$name.tar.xz
  if [ ! -f "$archive" ] || [ "$(sha256 "$archive")" != "$want" ]; then
    rm -f "$archive"
    if ! fetch "$url" "$archive.part"; then
      rm -f "$archive.part"
      echo "fetch-akku-lock: could not download $url" >&2
      status=1
      continue
    fi
    mv "$archive.part" "$archive"
  fi
  got=$(sha256 "$archive")
  if [ "$got" != "$want" ]; then
    rm -f "$archive"
    echo "fetch-akku-lock: $name's archive has sha256 $got, but $lock pins $want" >&2
    status=1
    continue
  fi
  rm -rf "$tree.tmp"
  mkdir -p "$tree.tmp"
  if ! tar -xf "$archive" -C "$tree.tmp" || [ -z "$(ls -A "$tree.tmp")" ]; then
    rm -rf "$tree.tmp"
    echo "fetch-akku-lock: could not unpack $archive" >&2
    status=1
    continue
  fi
  rm -rf "$tree" "$tree.sha256"
  mv "$tree.tmp" "$tree"
  echo "$want" > "$tree.sha256"
  echo "fetch-akku-lock: $name unpacked to $tree"
done
exit $status
